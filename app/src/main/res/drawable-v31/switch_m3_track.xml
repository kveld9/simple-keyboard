<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/system_accent1_600" />
            <corners android:radius="14dp" />
            <size android:width="46dp" android:height="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/system_neutral1_200" />
            <stroke android:width="1.5dp" android:color="@android:color/system_neutral2_400" />
            <corners android:radius="14dp" />
            <size android:width="46dp" android:height="26dp" />
        </shape>
    </item>
</selector>
