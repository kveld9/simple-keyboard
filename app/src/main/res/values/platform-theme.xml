<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="platformSettingsTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/M3PreferenceThemeOverlay</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="materialAlertDialogTheme">@style/platformDialogTheme</item>
        <item name="alertDialogTheme">@style/platformDialogTheme</item>
    </style>

    <style name="platformDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:listPreferredItemHeight">48dp</item>
        <item name="android:listPreferredItemHeightSmall">48dp</item>
        <item name="listPreferredItemHeight">48dp</item>
        <item name="listPreferredItemHeightSmall">48dp</item>
    </style>

    <style name="platformDialogTheme_Dark" parent="@style/platformDialogTheme">
        <item name="colorSurface">@color/background_lxx_dark</item>
        <item name="colorSurfaceContainerHigh">@color/background_secondary_lxx_dark</item>
        <item name="colorOnSurface">@color/key_text_color_lxx_dark</item>
        <item name="android:textColorPrimary">@color/key_text_color_lxx_dark</item>
    </style>

    <style name="platformDialogTheme_Black" parent="@style/platformDialogTheme">
        <item name="colorSurface">#121212</item>
        <item name="colorSurfaceContainerHigh">#1E1E1E</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0B0B0</item>
    </style>

    <style name="platformDialogBaseTheme_System" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialAlertDialogTheme">@style/platformDialogTheme</item>
        <item name="alertDialogTheme">@style/platformDialogTheme</item>
    </style>

    <style name="platformDialogBaseTheme_Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="materialAlertDialogTheme">@style/platformDialogTheme</item>
        <item name="alertDialogTheme">@style/platformDialogTheme</item>
    </style>

    <style name="platformDialogBaseTheme_Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="materialAlertDialogTheme">@style/platformDialogTheme_Dark</item>
        <item name="alertDialogTheme">@style/platformDialogTheme_Dark</item>
    </style>

    <style name="platformDialogBaseTheme_Black" parent="Theme.Material3.Dark.NoActionBar">
        <item name="materialAlertDialogTheme">@style/platformDialogTheme_Black</item>
        <item name="alertDialogTheme">@style/platformDialogTheme_Black</item>
    </style>

    <style name="M3PreferenceThemeOverlay" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryStyle">@style/M3PreferenceCategory</item>
        <item name="preferenceStyle">@style/M3Preference</item>
        <item name="switchPreferenceCompatStyle">@style/M3SwitchPreferenceCompat</item>
        <item name="dialogPreferenceStyle">@style/M3DialogPreference</item>
    </style>

    <style name="M3PreferenceCategory" parent="Preference.Category.Material">
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="android:layout">@layout/m3_preference_category</item>
    </style>

    <style name="M3Preference" parent="Preference.Material">
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="singleLineTitle">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:layout">@layout/m3_preference</item>
    </style>

    <style name="M3SwitchPreferenceCompat" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="singleLineTitle">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:layout">@layout/m3_preference</item>
        <item name="android:widgetLayout">@layout/m3_preference_widget_switch</item>
        <item name="widgetLayout">@layout/m3_preference_widget_switch</item>
    </style>

    <style name="M3DialogPreference" parent="Preference.DialogPreference.Material">
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="singleLineTitle">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:layout">@layout/m3_preference</item>
    </style>
</resources>
