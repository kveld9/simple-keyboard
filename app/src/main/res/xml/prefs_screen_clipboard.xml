<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:latin="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_screen_clipboard">

    <PreferenceCategory
        android:key="category_general"
        android:title="@string/settings_category_general">

        <SwitchPreferenceCompat
            android:key="pref_clipboard_enabled"
            android:title="@string/clipboard_enabled"
            android:summary="@string/clipboard_enabled_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_suggestions"
        android:title="@string/settings_category_suggestions">

        <SwitchPreferenceCompat
            android:key="pref_clipboard_suggestions"
            android:title="@string/clipboard_suggestions"
            android:summary="@string/clipboard_suggestions_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="pref_suggest_screenshots"
            android:title="@string/suggest_screenshots"
            android:summary="@string/suggest_screenshots_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_history"
        android:title="@string/settings_category_history">

        <rkr.simplekeyboard.inputmethod.latin.settings.SeekBarDialogPreference
            android:key="pref_clipboard_retention_time"
            android:title="@string/clipboard_history_retention_time"
            latin:minValue="30"
            latin:maxValue="720"
            latin:stepValue="30" />

    </PreferenceCategory>

</PreferenceScreen>
